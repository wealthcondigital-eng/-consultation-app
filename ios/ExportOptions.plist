<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- How `flutter build ipa` signs and exports the App Store build. Used by
     tool/ios_release.sh. Signing is automatic: the team comes from the Runner
     target (Xcode → Signing & Capabilities), so it is not repeated here. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The build number is pubspec.yaml's, the same one Play gets. Never let
	     the export rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
