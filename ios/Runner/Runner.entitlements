<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. "development" is correct here even for the App
	     Store: Xcode rewrites it to "production" when the archive is signed
	     with a distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Time Sensitive Notifications. An incoming consultation and the
	     "starting now" reminder are delivered at this level so they get
	     through a Focus mode; without the entitlement iOS quietly downgrades
	     them to ordinary alerts. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
