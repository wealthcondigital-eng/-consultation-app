<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon, used from Android 8 onwards. The launcher masks these
     layers to whatever shape the device uses - circle, squircle, teardrop - and
     parallaxes them against each other, which is why the mark is drawn well
     inside the safe zone rather than filling the canvas.

     The legacy `ic_launcher.png` in each mipmap folder is what Android 7 and
     below draw; it carries its own rounded tile because those launchers apply
     no mask of their own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_teal" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons: Android 13+ recolours this to the wallpaper palette.
         The mark is a single-colour silhouette, which is exactly what that
         mode needs - anything relying on two fills comes out unreadable. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
