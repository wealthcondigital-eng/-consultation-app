<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere, with a hole punched for the development API only.

  `API_BASE_URL` defaults to http://10.0.2.2:4000 — the emulator's route to the
  developer's machine — and Android has blocked cleartext by default since API
  28. Rather than turning cleartext on app-wide with `usesCleartextTraffic`,
  which would also apply to the production host, the exception is scoped to the
  loopback addresses a device can only reach on a developer's desk.

  A staging or production build points API_BASE_URL at an https:// host and is
  unaffected by anything below.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
